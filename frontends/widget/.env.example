# Chat widget frontend. Copy to `.env.local` for `npm run dev`,
# or to `.env` for docker compose (which overrides BACKEND_URL itself).

# Where this server reaches the FastAPI backend (never exposed to browsers).
BACKEND_URL=http://127.0.0.1:8500
# Chat-scope key created in Admin > Tài khoản & khoá API (or `python -m scripts.manage create-api-key`).
CHATBOT_API_KEY=
# Signs the anonymous visitor cookie; generate with: openssl rand -hex 32
VISITOR_COOKIE_SECRET=
# Sites allowed to embed the widget iframe (space separated).
WIDGET_ALLOWED_PARENTS=https://example.com https://www.example.com
