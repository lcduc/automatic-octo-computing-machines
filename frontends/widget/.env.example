# Chat widget frontend. Copy to `.env.local` for `npm run dev`.
# Under docker compose these come from the installer-generated `.env` at the
# repository/install root; nothing here is typed in by hand on a client box.

# Where this server reaches the FastAPI backend (never exposed to browsers).
BACKEND_URL=http://127.0.0.1:8500
# Shared with the backend's BFF_SERVICE_TOKEN.
BFF_SERVICE_TOKEN=
# Signs the anonymous visitor cookie; generate with: python -c "import secrets; print(secrets.token_hex(32))"
VISITOR_COOKIE_SECRET=
# Sites allowed to embed the widget iframe (space separated); the installer sets it to HOST_ORIGIN.
WIDGET_ALLOWED_PARENTS=https://example.com https://www.example.com
