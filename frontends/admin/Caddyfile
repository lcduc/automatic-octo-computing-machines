# Serves the built admin SPA inside the compose network (plain HTTP; TLS is
# terminated by the public Caddy in deploy/Caddyfile).
:80 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change; everything else must be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header -Server

	# Where the chat widget is served, for the widget preview. The image is shared
	# by every deployment, so the value comes from WIDGET_ORIGIN at run time.
	handle /runtime-config.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"widgetOrigin":"{$WIDGET_ORIGIN}"}` 200
	}

	# Client-side routes (/knowledge/…, /settings, …) all load index.html.
	try_files {path} /index.html
	file_server
}
