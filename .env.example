# =============================================================================
# RAG Chatbot configuration
# Copy to `.env` and adjust. Every variable below is read by config/settings.py;
# omitted variables fall back to the defaults shown in the comments.
# =============================================================================

# --- LLM provider selection ---------------------------------------------------
# Which backend answers chat turns: openai | anthropic | gemini.
# Only the block below matching your choice needs a real API key; the other
# two can stay blank. Voice transcription (/chat/transcribe) always uses
# OpenAI regardless of this setting (Anthropic/Gemini have no equivalent API).
LLM_PROVIDER=openai

# --- OpenAI --------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_LIGHT_MODEL=gpt-4.1-nano
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=30

OPENAI_TEMPERATURE=0.1
OPENAI_REASONING_EFFORT=low

TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_LANGUAGE=vi
TRANSCRIPTION_PROMPT=Đây là câu hỏi hoặc câu lệnh bằng tiếng Việt, được đưa ra trong một cuộc trò chuyện với AI agent hỗ trợ tra cứu tài liệu và thực hiện tác vụ.

# --- Anthropic (Claude) ---------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TIMEOUT=30

# --- Google Gemini ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=4000
GEMINI_TIMEOUT=30

# --- OCR (scanned/image-only PDFs) --------------------------------------------
DOCLING_OCR_ENABLED=True
OCR_CONCURRENT_PAGES=2
OCR_MAX_CONCURRENT_FILES=1
OCR_FORCE_ALL_PDFS=False

# Which OCR engine to use — see core/document_processing/ocr/:
#   auto    - local engine, GPU/CPU auto-detected (PaddleOCR-VL on GPU,
#             PP-OCRv6 on CPU). Both are multilingual (EN+VI, among others) —
#             no per-language configuration needed.
#   datalab - online, via Datalab's hosted Surya OCR API (requires
#             DATALAB_API_KEY below). Falls back to `auto` if no key is set.
OCR_PROVIDER=auto
DATALAB_API_KEY=

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8500
DEBUG=False
UVICORN_WORKERS=1

CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

API_KEY=

# Per-IP rate limiting (counters are per worker process).
RATE_LIMIT_ENABLED=False
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CONCURRENT=10

DESTRUCTIVE_CLEANUP_ENABLED=False

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_DIR=data/logs
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
REQUEST_LOGGING_ENABLED=True

# --- Audit trail (per-turn query/response/confidence log) --------------------
AUDIT_TRAIL_ENABLED=True
AUDIT_TRAIL_PATH=data/logs/audit_trail.jsonl

# --- LLM answer cache ---------------------------------------------------------
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_ENTRIES=1000
LLM_CACHE_MAX_SIZE=100
MAX_CONTEXT_LENGTH=5000
CHAT_BATCH_MAX_QUERIES=20

# --- Chat mode ---------------------------------------------------------------
# query_only | with_history
CHAT_MODE=with_history
MAX_HISTORY_TURNS=10

# --- File uploads ------------------------------------------------------------
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.doc,.csv,.xlsx,.xls
MAX_FILES_PER_BATCH=10
MAX_TOTAL_BATCH_SIZE=209715200
CHUNK_SIZE=1000
CHUNK_OVERLAP=0

# --- Storage paths -----------------------------------------------------------
CHUNKS_DIR=data/chunks
VECTORS_DIR=data/vectors
TEMP_DIR=data/temp
VECTOR_STORE_PATH=data/vectors/vector_store.pkl
MODELS_DIR=model_weights

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKING_ENABLED=True
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RETRIEVAL_TOP_K=3
SEMANTIC_WEIGHT=0.7
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_CHUNKS=5
MIN_CONTEXT_CHUNKS=2
CONTEXT_EXPANSION_ENABLED=True
CONTEXT_EXPANSION_RADIUS=1
USE_FAISS_INDEX=True
QUERY_ADAPTER_PATH=data/vectors/query_adapter.npy
RETRIEVAL_MAX_CONCURRENCY=4

# --- Vietnamese preprocessing ------------------------------------------------
VIETNAMESE_PREPROCESSING_ENABLED=True
CLEAN_SPECIAL_CHARS=True
EXTRACT_CONTENT_WORDS=True

# --- URL crawling ------------------------------------------------------------
CRAWL_TIMEOUT=30
CRAWL_MAX_PAGES=50
CRAWL_MAX_CONTENT_LENGTH=10485760

# --- Confidence scoring (weights should sum to 1.0) --------------------------
CONFIDENCE_SCORING_ENABLED=True
CONFIDENCE_CONTEXT_WEIGHT=0.35
CONFIDENCE_LENGTH_WEIGHT=0.20
CONFIDENCE_COHERENCE_WEIGHT=0.25
CONFIDENCE_CITATION_WEIGHT=0.10
CONFIDENCE_UNCERTAINTY_WEIGHT=0.10

# --- Health thresholds -------------------------------------------------------
SERVICE_SUCCESS_RATE_THRESHOLD=80.0
SERVICE_MIN_REQUESTS_FOR_HEALTH=10

# --- Streamlit frontend (app.py) ---------------------------------------------
API_BASE_URL=http://localhost:8500
AUTO_START_API=False
SHOW_SIDEBAR=True
ENABLE_URL_INPUTS=True
ENABLE_MAINTENANCE=False
