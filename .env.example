# =============================================================================
# Chatbot backend. Copy to `.env` and fill in the blanks.
# =============================================================================

# development | production (production refuses to start with unsafe settings)
APP_ENV=development
# Public domains; Caddy gets HTTPS certificates for both (the admin one is never embeddable)
PUBLIC_DOMAIN_CHAT=chat.example.com
PUBLIC_DOMAIN_ADMIN=admin.example.com
# Site(s) allowed to embed the widget iframe, space separated
HOST_ORIGIN=https://www.example.com

# Native development connects as the owner; under compose the API uses
# POSTGRES_APP_USER / POSTGRES_APP_PASSWORD and migrations read secrets/postgres_owner_password.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
# Shared with the widget server (frontends/widget BFF_SERVICE_TOKEN)
BFF_SERVICE_TOKEN=

# openai | anthropic | gemini, then set the matching key
LLM_PROVIDER=openai

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_LIGHT_MODEL=gpt-6-luna

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5

# --- Google (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# Local embedding model; changing it re-embeds every chunk at the next start
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKING_ENABLED=True
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval ------------------------------------------------------------------
# Minimum reranker score (0-1) a chunk needs: a floor; the model decides whether the documents answer
SIMILARITY_THRESHOLD=0.03
# Minimum cosine similarity instead when no reranker scored (off or failed); calibrated per EMBEDDING_MODEL
SEMANTIC_THRESHOLD=0.85
# --- Embedding router (small talk / human request / off-topic / vague message) ------
# How far the best route must lead the runner-up
ROUTE_MARGIN=0.01
# After an empty retrieval, refuse as off topic when the message is this much nearer the off-topic examples
ROUTE_OFF_TOPIC_LEAD=0.02
# Share of the semantic score in hybrid search (the rest is keyword/BM25)
SEMANTIC_WEIGHT=0.7
# Chunks kept after reranking, and the cap after neighbour expansion
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHUNKS=6

# OCR for PDFs with an empty or gibberish text layer (runs in the ingestion worker)
DOCLING_OCR_ENABLED=True
# OCR every PDF, even those with a usable text layer (needs DOCLING_OCR_ENABLED)
OCR_FORCE_ALL_PDFS=False

# --- Optional, commonly changed ----------------------------------------------
# Hosted OCR instead of the local models
# OCR_PROVIDER=datalab
# DATALAB_API_KEY=
