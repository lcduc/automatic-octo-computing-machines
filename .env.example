# =============================================================================
# Chatbot backend configuration. Copy to `.env` and fill in the secrets.
# docker-compose.yml reads this same file for the database container.
# Runtime chat behaviour (fallback mode, canned replies, widget look) is edited
# in the admin web; FALLBACK_MODE below is only the default. Prompt and reply
# text lives in core/agent/prompts.py, not here.
# =============================================================================

# development | production. Production refuses to start with unsafe settings.
APP_ENV=production
# IANA time zone for "today" in token budgets and daily statistics.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Public domain of the chat/admin site; Caddy obtains its HTTPS certificate.
CHAT_DOMAIN=chat.example.com
# Client frontend folder under frontends/ that docker-compose builds as `web`.
FRONTEND=

# --- Database (PostgreSQL 17 + pgvector, free & open source) -----------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DB_POOL_SIZE=10

# --- Security ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
# Origins allowed to call this API from a browser (the web frontend's URL).
CORS_ORIGINS=https://chat.example.com
# Proxies whose X-Forwarded-For is trusted (the Next.js server / Caddy network).
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=120
# Tokens one visitor may spend per day (0 = unlimited).
DAILY_TOKEN_BUDGET_PER_USER=60000
MAX_CONCURRENT_CHATS=16
PII_REDACTION_ENABLED=True
# Free OpenAI moderation endpoint; needs OPENAI_API_KEY.
MODERATION_ENABLED=True

# --- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8500
DEBUG=False

# --- LLM provider (openai | anthropic | gemini) ---------------------------------
LLM_PROVIDER=openai
TURN_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_LIGHT_MODEL=gpt-4.1-nano
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=30
OPENAI_TEMPERATURE=0.1
OPENAI_REASONING_EFFORT=low
TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_LANGUAGE=vi

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TIMEOUT=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=4000
GEMINI_TIMEOUT=30

# Answer cache (in process).
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_ENTRIES=1000
# Tool calling adds an intent-classification call to every turn; off by default.
TOOL_CALLING_ENABLED=False

# --- Chat policy defaults --------------------------------------------------------
MAX_HISTORY_TURNS=6
MAX_MESSAGE_LENGTH=2000
# deny = canned answer, no LLM call | handoff = transfer to a human
FALLBACK_MODE=deny

# --- Retrieval -------------------------------------------------------------------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKING_ENABLED=True
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RETRIEVAL_TOP_K=4
SEMANTIC_WEIGHT=0.7
# Minimum reranker score (0-1) for a chunk to count as relevant; below it the
# turn takes the fallback path without calling the LLM.
SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_CHUNKS=6
CONTEXT_EXPANSION_RADIUS=1
MAX_CONTEXT_LENGTH=6000
RETRIEVAL_MAX_CONCURRENCY=4
QUERY_ADAPTER_PATH=data/query_adapter.npy

# --- Uploads & document processing -------------------------------------------------
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx,.csv,.xlsx
CHUNK_SIZE=1000
CHUNK_OVERLAP=0
MAX_AUDIO_FILE_SIZE=26214400

DOCLING_OCR_ENABLED=True
OCR_CONCURRENT_PAGES=2
OCR_MAX_CONCURRENT_FILES=1
OCR_FORCE_ALL_PDFS=False
# auto (local GPU/CPU) | datalab (hosted, needs DATALAB_API_KEY)
OCR_PROVIDER=auto
DATALAB_API_KEY=

# --- Logging & paths -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=data/logs
MODELS_DIR=model_weights
SLOW_REQUEST_THRESHOLD_MS=8000
