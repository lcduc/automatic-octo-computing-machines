# =============================================================================
# Chatbot backend. Copy to `.env` and fill in the blanks.
# Listed: what a deployment must set, plus the model and retrieval knobs that get
# tuned often. Every other setting has a documented default in config/settings.py
# and config/platform_settings.py; add a line here to override one.
# Chat models and retrieval values can also be changed live in the admin web
# (Settings > Models & retrieval); the values here are the defaults it resets to.
# Runtime chat behaviour (fallback mode, canned replies, widget look) is edited
# in the admin web; prompt and reply text lives in core/agent/prompts.py.
# =============================================================================

# On a client box this file is written by the installer (`chatbot install`,
# docs/DEPLOYMENT.md): the answers fill the domains, host origin, alert channel
# and LLM key, and every secret below is generated. Use this template for
# native local development only.

# development | production (production refuses to start with unsafe settings)
APP_ENV=development
# Public domains; Caddy gets HTTPS certificates for both (the admin one is never embeddable)
PUBLIC_DOMAIN_CHAT=chat.example.com
PUBLIC_DOMAIN_ADMIN=admin.example.com
# Site(s) allowed to embed the widget iframe, space separated
HOST_ORIGIN=https://www.example.com

# Native development connects as the owner; under compose the API uses
# POSTGRES_APP_USER / POSTGRES_APP_PASSWORD and migrations read secrets/postgres_owner_password.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
# Shared with the widget server (frontends/widget BFF_SERVICE_TOKEN)
BFF_SERVICE_TOKEN=

# openai | anthropic | gemini, then set the matching key
LLM_PROVIDER=openai
# The OpenAI key is also used for moderation and voice input
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Models (providers rename models often) ----------------------------------
# Answer model and the cheaper model used for query rewriting / intent routing
OPENAI_MODEL=gpt-5-mini
OPENAI_LIGHT_MODEL=gpt-4.1-nano
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Voice input (OpenAI)
TRANSCRIPTION_MODEL=gpt-transcribe
# Local embedding model; changing it re-embeds every chunk at the next start
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKING_ENABLED=True
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# --- Retrieval ------------------------------------------------------------------
# Minimum relevance (0-1) a chunk needs; below it the turn takes the fallback path
SIMILARITY_THRESHOLD=0.3
# Share of the semantic score in hybrid search (the rest is keyword/BM25)
SEMANTIC_WEIGHT=0.7
# Chunks kept after reranking, and the cap after neighbour expansion
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHUNKS=6
# Neighbour chunks added on each side of a match (0 disables)
CONTEXT_EXPANSION_RADIUS=1
# Default chunking for new documents (characters; each upload can choose its own strategy)
CHUNK_SIZE=1000
CHUNK_OVERLAP=0

# OCR for scanned PDFs (runs in the ingestion worker)
DOCLING_OCR_ENABLED=True

# --- Optional, commonly changed ----------------------------------------------
# cpu for hosts without an NVIDIA GPU (build arg of the api image)
# TORCH_INDEX=cpu
# Hard limits of the ingestion-worker container; keep OCR_CPU_THREADS (default 2) below WORKER_CPUS
# WORKER_CPUS=3
# WORKER_MEMORY=6g
# Hosted OCR instead of the local models
# OCR_PROVIDER=datalab
# DATALAB_API_KEY=

# --- Operator alerts (the installer's [alert] answers) ---------------------------
# telegram | slack | smtp ; empty disables alerts
# ALERT_CHANNEL=telegram
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# Outgoing mail (e-mail alerts and ticket replies)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Signed-in users of the host site (the installer's [host_auth] answers) -------
# rs256 (default; the installer generates the key pair and hands the private key to
# the host) | hs256 (shared HOST_JWT_SECRET) | none (anonymous-only)
# HOST_AUTH_MODE=rs256
# HOST_JWKS_URL=
# HOST_JWT_PUBLIC_KEY_FILE=secrets/host_jwt_public.pem
# HOST_JWT_ISSUER defaults to the first HOST_ORIGIN, HOST_JWT_AUDIENCE to https://PUBLIC_DOMAIN_CHAT
# HOST_TIERS=user,premium
