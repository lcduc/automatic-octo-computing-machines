# API settings for a local load test (see docs/PERFORMANCE.md). Every value the run depends on
# is set here, so a stale .env cannot change what is measured. Local throwaway values only.
#
#   python -m dotenv -f scripts/loadtest/loadtest.env run --override -- python main.py

APP_ENV=development
PORT=8600
DATABASE_URL=postgresql+asyncpg://chatbot:dev@localhost:5432/chatbot_load
ADMIN_JWT_SECRET=loadtest-admin-secret-not-for-real-use-000000
BFF_SERVICE_TOKEN=loadtest-bff-token-not-for-real-use-0000000000

# Canned answers on a fixed schedule: about 0.4 s to the first token, 60 tokens at 25 ms
LLM_PROVIDER=stub
STUB_LLM_TTFT_MS=400
STUB_LLM_TOKEN_DELAY_MS=25
STUB_LLM_TOKENS=60
# No OpenAI key: no moderation call and no tool-calling agent, so no network in the turn
OPENAI_API_KEY=
TOOL_CALLING_ENABLED=false
# Every turn generates; a repeated golden question would otherwise be answered from the cache
LLM_CACHE_TTL=0

# Models load in this process on the local GPU (no model-server)
MODEL_SERVER_URL=
# A git worktree without its own model_weights/ can point this at the main checkout's copy instead
MODELS_DIR=model_weights
HF_HUB_OFFLINE=1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKING_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_MAX_CONCURRENCY=4
SIMILARITY_THRESHOLD=0.03
SEMANTIC_THRESHOLD=0.85
SEMANTIC_WEIGHT=0.7
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHUNKS=6

# The production bound under test: chat turns past this many get HTTP 503
MAX_CONCURRENT_CHATS=16
# Quotas stay on (their counters are part of every turn) but high enough never to trip
RATE_LIMIT_IP_PER_MINUTE=1000000
RATE_LIMIT_ANONYMOUS_PER_MINUTE=1000000
RATE_LIMIT_ANONYMOUS_PER_HOUR=1000000
TOKEN_BUDGET_ANONYMOUS_PER_DAY=1000000000
TOKEN_BUDGET_IP_PER_DAY=1000000000
